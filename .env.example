NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-with-a-local-password
NEO4J_DATABASE=neo4j
NEO4J_TEST_URI=bolt://localhost:7688
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=aml_investigation_copilot_entities
HEALTH_CHECK_TIMEOUT_SECONDS=3.0
LLM_MAX_TOKENS=2048
LLM_PROVIDER=anthropic
LLM_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Local vLLM usually ignores the key; leave blank to send a placeholder.
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=http://localhost:8001/v1
OPENAI_COMPAT_MODEL=Qwen/Qwen2.5-7B-Instruct
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
DATA_DIR=data
ER_MATCH_THRESHOLD=0.92
ER_REVIEW_THRESHOLD=0.75
RANDOM_SEED=42
# Phase 1 sampling and seeding (ADR 003). List values are JSON.
IBM_BENIGN_SEED_ACCOUNTS=8000
IBM_MAX_TXNS_PER_ACCOUNT=50
IBM_MAX_TRANSACTIONS=400000
IBM_DROP_SELF_TRANSFERS=true
OPENSANCTIONS_DATASETS=["us_ofac_sdn","eu_fsf","un_sc_sanctions"]
OPENSANCTIONS_ENTITY_SAMPLE_SIZE=25000
ICIJ_SOURCE_IDS=["Panama Papers"]
ICIJ_SEED_ENTITY_COUNT=3000
ICIJ_NODE_SAMPLE_SIZE=20000
ICIJ_RELATIONSHIP_SAMPLE_SIZE=80000
FAKER_LOCALES=["en_US","en_GB","de_DE","fr_FR","es_ES","it_IT","nl_NL","pt_BR"]
SEEDED_LINK_RATE=0.03
SEED_OPENSANCTIONS_SHARE=0.5
SEED_LAUNDERING_SHARE=0.5
SEED_MAX_PERTURBATIONS=2
HARD_NEGATIVE_RATE=0.01
GRAPH_BATCH_SIZE=2000
