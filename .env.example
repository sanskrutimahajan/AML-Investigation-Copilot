NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-with-a-local-password
NEO4J_DATABASE=neo4j
NEO4J_TEST_URI=bolt://localhost:7688
QDRANT_TEST_URL=http://localhost:6335
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=aml_investigation_copilot_entities
HEALTH_CHECK_TIMEOUT_SECONDS=3.0
# --- LLM (any provider, configured here only; never commit real keys) -----------------------
# Default: Ollama, local and free. Run natively on macOS: `ollama pull qwen2.5:7b-instruct`.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen2.5:7b-instruct
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=180
LLM_JSON_RETRIES=1
#
# OpenAI:      LLM_PROVIDER=openai_compatible  LLM_BASE_URL=https://api.openai.com/v1  LLM_API_KEY=sk-...  LLM_MODEL=gpt-4o-mini
# Groq:        LLM_PROVIDER=openai_compatible  LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_API_KEY=gsk_...  LLM_MODEL=llama-3.1-8b-instant
# Together:    LLM_PROVIDER=openai_compatible  LLM_BASE_URL=https://api.together.xyz/v1  LLM_API_KEY=...  LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct-Turbo
# vLLM:        LLM_PROVIDER=openai_compatible  LLM_BASE_URL=http://localhost:8001/v1  LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# LM Studio:   LLM_PROVIDER=openai_compatible  LLM_BASE_URL=http://localhost:1234/v1  LLM_MODEL=<loaded model id>
# Anthropic:   LLM_PROVIDER=anthropic  LLM_API_KEY=sk-ant-...  LLM_MODEL=claude-sonnet-5-5   (LLM_BASE_URL unused)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
DATA_DIR=data
ER_MATCH_THRESHOLD=0.92
ER_REVIEW_THRESHOLD=0.75
ER_BLOCK_MAX_TOKEN_FREQUENCY=300
ER_ANN_TOP_K=10
ER_EMBEDDING_BATCH_SIZE=256
ER_U_MAX_PAIRS=30000000
ER_DETERMINISTIC_RECALL=0.5
ER_PREDICTION_FLOOR=0.001
ER_REVIEW_QUEUE_CAP=1000
ER_BOOTSTRAP_SAMPLES=1000
ER_LLM_MAX_ALIASES=10

# Retrieval and Q&A (Phase 3)
QDRANT_NAMES_COLLECTION=aml_investigation_copilot_names
QA_MAX_ROWS=50
QA_MAX_HOPS=4
QA_QUERY_TIMEOUT_SECONDS=10
QA_LINK_TOP_K=5
QA_RRF_K=60
QA_LINK_MIN_VECTOR_SCORE=0.9
QA_CONTEXT_MAX_ITEMS=40
QA_CHECK_PER_FAMILY=10
RANDOM_SEED=42
# Phase 1 sampling and seeding (ADR 003). List values are JSON.
IBM_BENIGN_SEED_ACCOUNTS=8000
IBM_MAX_TXNS_PER_ACCOUNT=50
IBM_MAX_TRANSACTIONS=400000
IBM_DROP_SELF_TRANSFERS=true
OPENSANCTIONS_DATASETS=["us_ofac_sdn","eu_fsf","un_sc_sanctions"]
OPENSANCTIONS_ENTITY_SAMPLE_SIZE=25000
ICIJ_SOURCE_IDS=["Panama Papers"]
ICIJ_SEED_ENTITY_COUNT=3000
ICIJ_NODE_SAMPLE_SIZE=22000
ICIJ_RELATIONSHIP_SAMPLE_SIZE=80000
FAKER_LOCALES=["en_US","en_GB","de_DE","fr_FR","es_ES","it_IT","nl_NL","pt_BR"]
SEEDED_LINK_RATE=0.03
SEED_OPENSANCTIONS_SHARE=0.5
SEED_LAUNDERING_SHARE=0.5
SEED_ALIAS_RATE=0.15
PERSON_COMMA_FORMAT_RATE=0.1
NAME_EDIT_COUNT_WEIGHTS=[0.3,0.45,0.25]
HARD_NEGATIVE_RATE=0.01
HOMONYM_RATE=0.01
CUSTOMER_SOURCE_COUNTRY_RATE=0.5
CUSTOMER_UPPERCASE_RATE=0.3
GRAPH_BATCH_SIZE=2000
